#!/bin/bash
# Several Claude accounts side by side on one Mac. How it works: README.md.
#
# A profile is just a name: load_profile derives every path from it, so there
# is no registry. Each profile runs its own copy of Claude.app, and only the
# launcher (cmd_launch) creates or changes it: macOS lets an app modify only
# the apps it created itself.

set -eu

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/$(basename "${BASH_SOURCE[0]}")"
CLAUDE_APP="/Applications/Claude.app"
STATE="$HOME/Library/Application Support/claude-profiles"
INSTALL_CLAUDE_CODE="curl -fsSL https://claude.ai/install.sh | bash"
LSREGISTER=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister

SETUP_ITEMS="settings.json CLAUDE.md keybindings.json skills commands agents hooks output-styles
  plugins/installed_plugins.json plugins/known_marketplaces.json plugins/config.json
  plugins/blocklist.json plugins/cache plugins/marketplaces plugins/repos"

COLOR_HUE_DEGREES="orange:25 red:330 yellow:55 green:110 teal:160 blue:210 purple:265 pink:300"

say()  { printf '%s\n' "$*"; }
warn() { printf 'claude-profiles: %s\n' "$*" >&2; }
die()  { warn "$*"; exit 1; }
log()  { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"; }

load_profile() {
  NAME="$1"
  [[ "$NAME" =~ ^[a-z][a-z0-9-]{0,30}$ ]] ||
    die "profile name must be lowercase letters, digits and dashes: '$NAME'"
  [ "$NAME" != "profiles" ] || die "'profiles' is taken by the command itself"
  DIR="$STATE/$NAME"
  COPY="$DIR/Claude $NAME.app"
  LAUNCHER="$HOME/Applications/Claude $NAME.app"
  DATA="$HOME/Library/Application Support/Claude-$NAME"
  CONFIG="$HOME/.claude-$NAME"
}

require_profile() {
  load_profile "$1"
  [ -d "$DIR" ] || die "no profile '$NAME'. Create it with: claude-profiles add $NAME"
}

profile_names() {
  [ -d "$STATE" ] || return 0
  for d in "$STATE"/*/; do
    if [ -d "$d" ]; then basename "$d"; fi
  done
}


# ---- Commands ----------------------------------------------------------------

usage() {
  cat <<'EOF'
claude-profiles: several Claude accounts side by side on one Mac. See README.md.

  claude-profiles add <name> [--color <c>] [--icon <image>] [--settings shared|copy|empty]
  claude-profiles check
  claude-profiles remove <name>
  claude-profiles init         the claude-<name> commands, for eval in your shell file
  claude-<name> [args]         Claude Code in that profile
EOF
}

cmd_add() {
  [ $# -ge 1 ] || { usage; exit 1; }
  load_profile "$1"; shift
  local color="" icon="" settings=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --color)    color=$(hue_of "${2:?}"); shift 2 ;;
      --icon)     icon="${2:?}"; [ -f "$icon" ] || die "no such file: $icon"; shift 2 ;;
      --settings) settings="${2:?}"; shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  [ -d "$CLAUDE_APP" ] || die "Claude is not installed in /Applications"
  mkdir -p "$DIR"

  if [ -n "$color" ]; then echo "$color" > "$DIR/color"; rm -f "$DIR/icon.png"; fi
  if [ -n "$icon" ];  then sips -s format png "$icon" --out "$DIR/icon.png" >/dev/null; rm -f "$DIR/color"; fi

  if [ ! -e "$CONFIG" ]; then
    if [ -z "$settings" ]; then
      say "Claude Code setup for '$NAME' (CLAUDE.md, settings, skills, commands, agents, plugins, MCP servers):"
      say "  1) shared with your main Claude: change it once, both see it   [default]"
      say "  2) copied now, then separate"
      say "  3) start empty"
      read -r -p "Choose 1-3: " answer
      case "${answer:-1}" in 1) settings=shared ;; 2) settings=copy ;; 3) settings=empty ;; *) die "no such choice" ;; esac
    fi
    case "$settings" in shared|copy|empty) ;; *) die "--settings must be shared, copy or empty" ;; esac
    seed_config "$settings"
  elif [ "$(cat "$DIR/settings" 2>/dev/null)" = shared ]; then
    seed_config shared
  fi

  make_launcher
  "$LSREGISTER" -f "$LAUNCHER" 2>/dev/null || true

  say "Profile '$NAME' is ready. Drag \"$LAUNCHER\" to the Dock, open it and"
  say "sign in with \"Continue with email\" (README.md: Signing in to Desktop)."
  shell_has_init || say "For the claude-$NAME command, add to ~/.zshrc or ~/.bash_profile: $(init_line)"
}

# Run by the Dock launcher.
cmd_launch() {
  require_profile "$1"
  PATH=/usr/bin:/bin:/usr/sbin:/sbin
  [ -f "$DIR/launch.log" ] && tail -n 200 "$DIR/launch.log" > "$DIR/launch.log.tmp" && mv "$DIR/launch.log.tmp" "$DIR/launch.log"
  exec >> "$DIR/launch.log" 2>&1

  if [ -z "$(running_copy)" ]; then
    refresh_copy || log "could not build the copy; opening the one there is"
    block_self_update || log "could not block self-updates"
  fi
  if icon_outdated; then
    local r; r=$(apply_profile_icon "$COPY" "$COPY")
    [ "$r" = none ] || log "icon: $r"
  fi
  log "opening"
  # Full flags even to focus a running copy: if it is quitting, macOS starts it
  # again, and it must come back on the right account.
  open -a "$COPY" --env "CLAUDE_CONFIG_DIR=$CONFIG" --args --user-data-dir="$DATA"
}

# Run by claude-<name>.
cmd_code() {
  require_profile "$1"; shift
  command -v claude >/dev/null || die "no claude command. Install it: $INSTALL_CLAUDE_CODE"
  local now main
  now=$(account_email "$CONFIG/.claude.json")
  main=$(account_email "$HOME/.claude.json")
  if [ -n "$now" ] && [ "$now" = "$main" ]; then
    warn "'$NAME' is signed in to the same account as your main Claude ($now). Use /logout, then /login with the other account."
  fi
  CLAUDE_CONFIG_DIR="$CONFIG" exec claude "$@"
}

cmd_init() {
  local name
  printf 'claude-profiles() { %q "$@"; }\n' "$SELF"
  for name in $(profile_names); do
    printf 'claude-%s() { %q code %s "$@"; }\n' "$name" "$SELF" "$name"
  done
}

cmd_check() {
  local problems=0 name main email desktop item
  bad() { say "  ✗ $*"; problems=$((problems + 1)); }

  main=$(account_email "$HOME/.claude.json")
  printf '%-12s %-9s %s\n' PROFILE DESKTOP "CLAUDE CODE ACCOUNT"
  printf '%-12s %-9s %s\n' "(main)" - "${main:--}"
  [ -d "$CLAUDE_APP" ] || bad "Claude is not in /Applications"
  command -v claude >/dev/null || bad "no claude command. Install it: $INSTALL_CLAUDE_CODE"
  shell_has_init || bad "no claude-<name> commands. Add to ~/.zshrc or ~/.bash_profile: $(init_line)"

  for name in $(profile_names); do
    load_profile "$name"
    email=$(account_email "$CONFIG/.claude.json")
    desktop=stopped
    [ -z "$(running_copy)" ] || desktop=running
    printf '%-12s %-9s %s\n' "$name" "$desktop" "${email:--}"

    launcher_is_current || bad "launcher missing or points elsewhere. Fix: claude-profiles add $name"
    if [ -d "$COPY" ] && ! self_update_blocked; then
      if [ -e "$DATA-3p" ]; then
        bad "the copy can update itself and reopen on the wrong account. $DATA-3p holds settings this script never touches; set \"disableAutoUpdates\": true in its active configuration"
      else
        bad "the copy can update itself and reopen on the wrong account. Fix: click the launcher once"
      fi
    fi
    if [ "$(cat "$DIR/settings" 2>/dev/null)" = shared ]; then
      for item in $SETUP_ITEMS; do
        if [ -e "$HOME/.claude/$item" ] && [ ! -L "$CONFIG/$item" ]; then
          bad "$CONFIG/$item is not shared. Move it aside if it is there, then run: claude-profiles add $name"
        fi
      done
    fi
    if [ -z "$email" ]; then
      bad "Claude Code is not signed in. Run claude-$name, then /login"
    elif [ "$email" = "$main" ]; then
      bad "Claude Code is signed in to the same account as your main Claude. In claude-$name: /logout, then /login with the other account"
    fi
  done

  say ""
  if [ "$problems" = 0 ]; then say "All good."; else say "$problems problem(s)."; exit 1; fi
}

cmd_remove() {
  [ $# -eq 1 ] || { usage; exit 1; }
  require_profile "$1"
  [ -z "$(running_copy)" ] || die "Claude '$NAME' is open. Quit it first"
  rm -rf "$LAUNCHER"
  rm -rf "$DIR" 2>/dev/null || die "could not delete $DIR. Drag it to the Trash in Finder, then run this again"
  unblock_self_update
  say "Removed '$NAME'. Its sign-in and chats stay in $DATA and $CONFIG"
  say "(README.md says how to delete them). Unpin the launcher from the Dock."
}


# ---- Claude Code settings ------------------------------------------------------

seed_config() {
  local mode=$1 item
  mkdir -p "$CONFIG"
  echo "$mode" > "$DIR/settings"
  [ "$mode" = empty ] && return 0
  for item in $SETUP_ITEMS; do
    [ -e "$HOME/.claude/$item" ] || continue
    [ -e "$CONFIG/$item" ] || [ -L "$CONFIG/$item" ] && continue
    mkdir -p "$(dirname "$CONFIG/$item")"
    if [ "$mode" = shared ]; then ln -s "$HOME/.claude/$item" "$CONFIG/$item"; else cp -R "$HOME/.claude/$item" "$CONFIG/$item"; fi
  done
  if [ "$mode" = copy ]; then
    # Copied files still point into ~/.claude.
    for item in settings.json plugins/installed_plugins.json plugins/known_marketplaces.json; do
      if [ -f "$CONFIG/$item" ]; then sed -i '' "s#$HOME/.claude/#$CONFIG/#g" "$CONFIG/$item"; fi
    done
  fi
  copy_mcp_servers
}

# The rest of ~/.claude.json is your main login.
copy_mcp_servers() {
  [ -f "$HOME/.claude.json" ] && [ ! -e "$CONFIG/.claude.json" ] || return 0
  local servers
  servers=$(plutil -extract mcpServers json -o - "$HOME/.claude.json" 2>/dev/null) || return 0
  (umask 077; printf '{ "mcpServers": %s }\n' "$servers" > "$CONFIG/.claude.json")
}

init_line() {
  printf 'eval "$(%q init)"' "$SELF"
}

shell_has_init() {
  grep -qs 'claude-profiles init' "$HOME/.zshrc" "$HOME/.bash_profile"
}


# ---- Launcher and icons --------------------------------------------------------

# Apps started from the Dock get no PATH, hence the full path to this script.
make_launcher() {
  local script out
  script=$(printf '%s' "$SELF" | sed 's/[\\"]/\\&/g')
  mkdir -p "$HOME/Applications"
  rm -rf "$LAUNCHER"
  out=$(osacompile -o "$LAUNCHER" -e \
    "do shell script quoted form of \"$script\" & \" launch $NAME > /dev/null 2>&1 &\"" 2>&1) ||
    die "could not build the launcher: $out"
  # Its own bundle id, so macOS keeps each profile's launcher apart.
  /usr/libexec/PlistBuddy -c "Add :CFBundleIdentifier string local.claude-profiles.$NAME" "$LAUNCHER/Contents/Info.plist"
  if [ "$(apply_profile_icon "$LAUNCHER" "$CLAUDE_APP")" != ok ]; then
    sips -s format png "$(ls "$CLAUDE_APP/Contents/Resources/"*.icns | head -1)" --out "$DIR/.claude.png" >/dev/null
    set_icon "$DIR/.claude.png" "$LAUNCHER" >/dev/null
  fi
}

launcher_is_current() {
  [ -d "$LAUNCHER" ] && osadecompile "$LAUNCHER" 2>/dev/null | grep -qF "$SELF"
}

hue_of() {
  local pair
  for pair in $COLOR_HUE_DEGREES; do [ "${pair%%:*}" = "$1" ] && { echo "${pair#*:}"; return; }; done
  die "unknown colour '$1'. Choose one of: $(for p in $COLOR_HUE_DEGREES; do printf '%s ' "${p%%:*}"; done)"
}

# Prints ok, none (no icon chosen) or what went wrong.
apply_profile_icon() {
  local app=$1 source_app=$2 png="$DIR/icon.png"
  if [ -f "$DIR/color" ]; then
    png="$DIR/.tinted.png"
    local r; r=$(tint_icon "$source_app" "$(cat "$DIR/color")" "$png")
    [ "$r" = ok ] || { echo "$r"; return; }
  fi
  [ -f "$png" ] || { echo none; return; }
  set_icon "$png" "$app"
}

icon_outdated() {
  local custom_icon="$COPY/Icon"$'\r'
  [ ! -e "$custom_icon" ] || [ "$DIR/color" -nt "$custom_icon" ] || [ "$DIR/icon.png" -nt "$custom_icon" ]
}

tint_icon() {
  local source_app=$1 hue=$2 png=$3 icns
  icns=$(ls "$source_app/Contents/Resources/"*.icns 2>/dev/null | head -1)
  [ -n "$icns" ] || { echo "no icon in $source_app"; return 0; }
  osascript -l JavaScript - "$icns" "$hue" "$png" <<'JS'
ObjC.import('AppKit'); ObjC.import('CoreImage');
function run(argv) {
  var input = $.CIImage.imageWithData($.NSData.dataWithContentsOfFile(argv[0]));
  var filter = $.CIFilter.filterWithName('CIHueAdjust');
  filter.setValueForKey(input, 'inputImage');
  filter.setValueForKey($.NSNumber.numberWithDouble(parseFloat(argv[1]) * Math.PI / 180), 'inputAngle');
  var rep = $.NSCIImageRep.imageRepWithCIImage(filter.valueForKey('outputImage'));
  var image = $.NSImage.alloc.initWithSize(rep.size);
  image.addRepresentation(rep);
  var png = $.NSBitmapImageRep.imageRepWithData(image.TIFFRepresentation)
    .representationUsingTypeProperties($.NSBitmapImageFileTypePNG, $());
  return png.writeToFileAtomically(argv[2], true) ? 'ok' : 'cannot write ' + argv[2];
}
JS
}

set_icon() {
  local image=$1 app=$2
  osascript -l JavaScript - "$image" "$app" <<'JS'
ObjC.import('AppKit');
function run(argv) {
  var image = $.NSImage.alloc.initWithContentsOfFile(argv[0]);
  if (image.isNil()) return 'cannot read ' + argv[0];
  return $.NSWorkspace.sharedWorkspace.setIconForFileOptions(image, argv[1], 0) ? 'ok' : 'cannot set icon';
}
JS
}


# ---- The copy of Claude --------------------------------------------------------

# Called as refresh_copy || log, where set -e is off, so each step checks itself.
refresh_copy() {
  local have want
  want=$(app_version "$CLAUDE_APP")
  have=$(app_version "$COPY")
  [ -n "$want" ] || return 1
  [ "$have" = "$want" ] && return 0
  log "building the copy from Claude $want (had: ${have:-none})"
  rm -rf "$COPY.new" || return 1
  cp -Rc "$CLAUDE_APP" "$COPY.new" 2>/dev/null ||
    { rm -rf "$COPY.new" && cp -R "$CLAUDE_APP" "$COPY.new"; } || return 1
  rm -rf "$COPY" && mv "$COPY.new" "$COPY"
}

app_version() {
  [ -f "$1/Contents/Info.plist" ] || return 0
  /usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$1/Contents/Info.plist" 2>/dev/null
}

running_copy() {
  local main_process="$COPY/Contents/MacOS/"
  ps -axww -o pid=,command= | grep -F "$main_process" | grep -v grep || true
}

# A self-update relaunches the copy without --user-data-dir, on the wrong account.
# The -3p folder may hold your own provider setup, so it is written only when absent.
block_self_update() {
  local root="$DATA-3p" id
  [ -e "$root" ] && return 0
  id=$(uuidgen | tr 'A-Z' 'a-z')
  mkdir -p "$root/configLibrary" &&
    printf '{ "disableAutoUpdates": true }\n' > "$root/configLibrary/$id.json" &&
    policy_meta "$id" > "$root/configLibrary/_meta.json" &&
    echo "$id" > "$root/written-by-claude-profiles"
}

policy_meta() {
  printf '{ "appliedId": "%s", "entries": [ { "id": "%s", "name": "Default" } ] }\n' "$1" "$1"
}

unblock_self_update() {
  local root="$DATA-3p" id
  id=$(cat "$root/written-by-claude-profiles" 2>/dev/null) || return 0
  # Changed since we wrote it: it may hold your own settings now, so it stays.
  if policy_meta "$id" | cmp -s - "$root/configLibrary/_meta.json"; then
    rm -f "$root/configLibrary/$id.json" "$root/configLibrary/_meta.json"
  fi
  rm -f "$root/written-by-claude-profiles"
  rmdir "$root/configLibrary" "$root" 2>/dev/null || true
}

self_update_blocked() {
  grep -qs '"disableAutoUpdates" *: *true' "$DATA-3p/configLibrary/"*.json
}

# Only inside oauthAccount: MCP server settings may hold an emailAddress too.
account_email() {
  sed -n '/"oauthAccount"/,/}/s/.*"emailAddress": *"\([^"]*\)".*/\1/p' "$1" 2>/dev/null | head -1
}


case "${1:-}" in
  add)    shift; cmd_add "$@" ;;
  check)  shift; cmd_check ;;
  remove) shift; cmd_remove "$@" ;;
  init)   shift; cmd_init ;;
  launch) shift; cmd_launch "$@" ;;
  code)   shift; cmd_code "$@" ;;
  ""|-h|--help|help) usage ;;
  *) usage; exit 1 ;;
esac
